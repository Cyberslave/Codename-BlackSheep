@app.route("/admin/administrators/new", methods=["GET", "POST"])
@admin_management_required
def admin_administrators_new():
    if request.method == "POST":
        f = {k: request.form.get(k, "").strip() for k in ("full_name", "email", "phone")}
        level = request.form.get("level", "ADM")
        if not f["full_name"]:
            flash("Enter the administrator's full name.", "error")
        elif level not in ADMIN_LEVELS:
            flash("Choose a valid administrator level.", "error")
        elif f["email"] and not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", f["email"]):
            flash("Enter a valid email address or leave it blank.", "error")
        else:
            db = get_db()
            eid = new_employee_id(db, level)
            password = gen_password()
            db.execute(
                "INSERT INTO employees (id, full_name, email, phone, level, "
                "password_hash, must_change_password, is_admin, created_at, created_by) "
                "VALUES (?,?,?,?,?,?,1,1,?,?)",
                (eid, f["full_name"], f["email"], f["phone"], level,
                 generate_password_hash(password), iso(now()), g.user["id"]))
            (EMP_DIR / eid).mkdir(parents=True, exist_ok=True)
            audit(g.user["id"], "admin_created", eid, f["full_name"])
            db.commit()
            commit_github(f"Admin created: {eid}")
            return render_template("admin_created.html",
                emp=get_emp(eid), password=password, reset=False)
    return render_template("admin_administrators_new.html",
                           admin_levels=ADMIN_LEVELS, levels=LEVEL_NAMES)


@app.route("/admin/administrators/<eid>")
@admin_management_required
def admin_administrators_view(eid):
    emp = get_emp(eid)
    if not (emp["is_admin"] or emp["level"] == ADMIN_LEVEL):
        abort(404)
    return render_template("admin_administrators_view.html", emp=emp,
                           admin_levels=ADMIN_LEVELS, levels=LEVEL_NAMES)


@app.post("/admin/administrators/<eid>/edit")
@admin_management_required
def admin_administrators_edit(eid):
    emp = get_emp(eid)
    if not (emp["is_admin"] or emp["level"] == ADMIN_LEVEL):
        abort(404)
    f = {k: request.form.get(k, "").strip() for k in ("full_name", "email", "phone")}
    level = request.form.get("level", emp["level"])
    if not f["full_name"]:
        flash("The name cannot be empty.", "error")
    elif level not in ADMIN_LEVELS:
        flash("Invalid level.", "error")
    else:
        db = get_db()
        db.execute("UPDATE employees SET full_name=?, email=?, phone=?, level=? WHERE id=?",
                   (f["full_name"], f["email"], f["phone"], level, emp["id"]))
        audit(g.user["id"], "admin_edited", emp["id"], f["full_name"])
        db.commit()
        commit_github(f"Admin edited: {emp['id']}")
        flash("Administrator updated.", "ok")
    return redirect(url_for("admin_administrators_view", eid=emp["id"]))


@app.post("/admin/administrators/<eid>/demote")
@admin_management_required
def admin_administrators_demote(eid):
    emp = get_emp(eid)
    if not (emp["is_admin"] or emp["level"] == ADMIN_LEVEL):
        abort(404)
    if emp["id"] == g.user["id"]:
        flash("You cannot demote yourself.", "error")
        return redirect(url_for("admin_administrators_view", eid=eid))
    db = get_db()
    if db.execute("SELECT COUNT(*) FROM employees WHERE is_admin=1").fetchone()[0] <= 1:
        flash("You cannot demote the last administrator.", "error")
        return redirect(url_for("admin_administrators_view", eid=eid))
    db.execute("UPDATE employees SET is_admin=0, level='STF' WHERE id=?", (eid,))
    db.execute("UPDATE sessions_log SET logout_at=?, logout_reason='Demoted' "
               "WHERE employee_id=? AND logout_at IS NULL", (iso(now()), eid))
    audit(g.user["id"], "admin_demoted", eid, emp["full_name"])
    db.commit()
    commit_github(f"Admin demoted: {eid}")
    flash(f"{emp['full_name']} is no longer an administrator.", "ok")
    return redirect(url_for("admin_administrators"))


