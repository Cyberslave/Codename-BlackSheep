"""Persman: sales, expenses, administrators, business dashboard."""
import datetime as dt
import re
from functools import wraps

from flask import (abort, flash, g, redirect, render_template, request,
                   url_for)
from werkzeug.security import generate_password_hash

from app import (ADMIN_LEVEL, EMP_DIR, LEVEL_NAMES, LEVELS, app, audit,
                 commit_github, gen_password, get_db, get_emp, iso,
                 new_employee_id, now, password_problem)
from features import get_brand
from letterhead import letterhead_html


BUSINESS_LEVELS = ("EXE", "MGT", "SUP")
ADMIN_LEVELS = ("EXE", "MGT", "ADM")


def _can_business(user):
    if not user:
        return False
    if user["is_admin"]:
        return True
    return user["level"] in BUSINESS_LEVELS


def _can_manage_admins(user):
    if not user:
        return False
    if user["is_admin"]:
        return True
    return user["level"] in ADMIN_LEVELS


def business_required(fn):
    @wraps(fn)
    def wrapper(*a, **kw):
        if not g.user:
            return redirect(url_for("login"))
        if not _can_business(g.user):
            abort(403)
        return fn(*a, **kw)
    return wrapper


def admin_management_required(fn):
    @wraps(fn)
    def wrapper(*a, **kw):
        if not g.user:
            return redirect(url_for("login"))
        if not _can_manage_admins(g.user):
            abort(403)
        return fn(*a, **kw)
    return wrapper


SCHEMA = """
CREATE TABLE IF NOT EXISTS customers (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  email TEXT, phone TEXT, address TEXT, tax_number TEXT, notes TEXT,
  is_active INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL, created_by TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS ix_customers_name ON customers(name);

CREATE TABLE IF NOT EXISTS products (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL, description TEXT,
  price_cents INTEGER NOT NULL DEFAULT 0,
  is_service INTEGER NOT NULL DEFAULT 0,
  is_active INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL, created_by TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS sales (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  invoice_no TEXT NOT NULL UNIQUE,
  customer_id INTEGER NOT NULL,
  sale_date TEXT NOT NULL, due_date TEXT,
  subtotal_cents INTEGER NOT NULL DEFAULT 0,
  tax_cents INTEGER NOT NULL DEFAULT 0,
  total_cents INTEGER NOT NULL DEFAULT 0,
  amount_paid_cents INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'sent',
  notes TEXT,
  created_at TEXT NOT NULL, created_by TEXT NOT NULL,
  voided_at TEXT, void_reason TEXT
);
CREATE INDEX IF NOT EXISTS ix_sales_customer ON sales(customer_id, sale_date);
CREATE INDEX IF NOT EXISTS ix_sales_status ON sales(status, sale_date);

CREATE TABLE IF NOT EXISTS sale_items (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  sale_id INTEGER NOT NULL,
  product_id INTEGER,
  description TEXT NOT NULL,
  quantity REAL NOT NULL DEFAULT 1,
  unit_price_cents INTEGER NOT NULL DEFAULT 0,
  line_total_cents INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS ix_sale_items_sale ON sale_items(sale_id);

CREATE TABLE IF NOT EXISTS sale_payments (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  sale_id INTEGER NOT NULL,
  amount_cents INTEGER NOT NULL,
  paid_on TEXT NOT NULL, method TEXT NOT NULL,
  reference TEXT, note TEXT, receipt_no TEXT,
  created_at TEXT NOT NULL, created_by TEXT NOT NULL,
  voided_at TEXT, void_reason TEXT
);
CREATE INDEX IF NOT EXISTS ix_sale_payments_sale ON sale_payments(sale_id);

CREATE TABLE IF NOT EXISTS expense_categories (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE, is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS expenses (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  category_id INTEGER NOT NULL,
  description TEXT NOT NULL, amount_cents INTEGER NOT NULL,
  expense_date TEXT NOT NULL, supplier TEXT, reference TEXT,
  status TEXT NOT NULL DEFAULT 'pending', notes TEXT,
  created_at TEXT NOT NULL, created_by TEXT NOT NULL,
  approved_at TEXT, approved_by TEXT, rejected_reason TEXT, voided_at TEXT
);
CREATE INDEX IF NOT EXISTS ix_expenses_status ON expenses(status, expense_date);
"""


def init_business_db():
    import sqlite3
    from app import DB_PATH
    con = sqlite3.connect(DB_PATH)
    con.executescript(SCHEMA)
    have = con.execute("SELECT COUNT(*) FROM expense_categories").fetchone()[0]
    if have == 0:
        for name in ("Rent", "Utilities", "Salaries", "Supplies", "Transport",
                     "Marketing", "Maintenance", "Other"):
            con.execute("INSERT OR IGNORE INTO expense_categories (name) VALUES (?)", (name,))
    con.commit()
    con.close()


init_business_db()


def money(cents, cur="R"):
    whole, frac = divmod(abs(int(cents or 0)), 100)
    return f"{'-' if cents < 0 else ''}{cur}{whole:,}.{frac:02d}"


app.add_template_filter(money, "money")


def parse_money(text):
    cleaned = re.sub(r"[^\d.\-]", "", text or "")
    if cleaned.count("-") > 1 or ("-" in cleaned and not cleaned.startswith("-")):
        return None
    try:
        d = float(cleaned)
    except ValueError:
        return None
    if abs(d) > 1e9:
        return None
    return int(round(d * 100))


def parse_date(text):
    text = (text or "").strip()
    if not text:
        return None
    try:
        return dt.datetime.strptime(text, "%Y-%m-%d").date()
    except ValueError:
        return None


def next_invoice_no(db):
    year = now().year
    prefix = f"INV-{year}-"
    row = db.execute(
        "SELECT invoice_no FROM sales WHERE invoice_no LIKE ? "
        "ORDER BY id DESC LIMIT 1", (prefix + "%",)).fetchone()
    n = 1
    if row:
        try:
            n = int(row["invoice_no"].split("-")[-1]) + 1
        except ValueError:
            n = 1
    return f"{prefix}{n:04d}"


def next_receipt_no(db, sale_id):
    year = now().year
    count = db.execute(
        "SELECT COUNT(*) FROM sale_payments WHERE sale_id=?", (sale_id,)).fetchone()[0]
    return f"R{year}-{sale_id:04d}-{count + 1:02d}"


@app.route("/admin/business")
@business_required
def admin_business():
    db = get_db()
    today = now().date()
    month_start = today.replace(day=1).isoformat()
    year_start = today.replace(month=1, day=1).isoformat()

    rev_month = db.execute(
        "SELECT COALESCE(SUM(amount_cents),0) FROM sale_payments "
        "WHERE voided_at IS NULL AND paid_on>=?", (month_start,)).fetchone()[0]
    rev_year = db.execute(
        "SELECT COALESCE(SUM(amount_cents),0) FROM sale_payments "
        "WHERE voided_at IS NULL AND paid_on>=?", (year_start,)).fetchone()[0]
    exp_month = db.execute(
        "SELECT COALESCE(SUM(amount_cents),0) FROM expenses "
        "WHERE voided_at IS NULL AND status='approved' AND expense_date>=?",
        (month_start,)).fetchone()[0]
    exp_year = db.execute(
        "SELECT COALESCE(SUM(amount_cents),0) FROM expenses "
        "WHERE voided_at IS NULL AND status='approved' AND expense_date>=?",
        (year_start,)).fetchone()[0]

    outstanding = db.execute(
        "SELECT COALESCE(SUM(total_cents - amount_paid_cents),0) FROM sales "
        "WHERE voided_at IS NULL AND status IN ('sent','part-paid')").fetchone()[0]
    overdue = db.execute(
        "SELECT COALESCE(SUM(total_cents - amount_paid_cents),0) FROM sales "
        "WHERE voided_at IS NULL AND status IN ('sent','part-paid') "
        "AND due_date IS NOT NULL AND due_date<?", (today.isoformat(),)).fetchone()[0]

    pending = db.execute(
        "SELECT COUNT(*), COALESCE(SUM(amount_cents),0) FROM expenses "
        "WHERE voided_at IS NULL AND status='pending'").fetchone()

    recent_sales = db.execute(
        "SELECT s.*, c.name AS customer_name FROM sales s "
        "JOIN customers c ON c.id=s.customer_id "
        "WHERE s.voided_at IS NULL ORDER BY s.created_at DESC LIMIT 10").fetchall()
    recent_expenses = db.execute(
        "SELECT e.*, ec.name AS category_name FROM expenses e "
        "JOIN expense_categories ec ON ec.id=e.category_id "
        "WHERE e.voided_at IS NULL ORDER BY e.created_at DESC LIMIT 10").fetchall()

    return render_template("business_dashboard.html",
        rev_month=rev_month, rev_year=rev_year,
        exp_month=exp_month, exp_year=exp_year,
        profit_month=rev_month - exp_month, profit_year=rev_year - exp_year,
        outstanding=outstanding, overdue=overdue,
        pending_count=pending[0], pending_total=pending[1],
        recent_sales=recent_sales, recent_expenses=recent_expenses,
        today=today)


